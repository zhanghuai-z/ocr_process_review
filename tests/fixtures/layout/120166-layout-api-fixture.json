              },
              {
                "block_label": "text",
                "block_content": "时,2016年增值税分成改革导致的原营业税分成比例下降,进一步弱化了地方政府推动本地服务业发展、刺激本地服务消费的财政动机。这种财政资源向供给端的相对倾斜,会导致商品消费需求增速滞后于商品供给增速,带来地区商品供需适配问题。",
                "block_bbox": [
                  291,
                  403,
                  2155,
                  697
                ],
                "block_id": 1,
                "block_order": 1,
                "group_id": 1,
                "block_polygon_points": [
