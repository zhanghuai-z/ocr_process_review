                ]
              },
              {
                "block_label": "display_formula",
                "block_content": " $$ Y_{_{c t}}=\\alpha+\\beta Incentive_{_{c}}\\times Post_{_{t}}+\\gamma X_{_{c t}}+\\delta_{_{c}}+\\varphi_{_{t}}+\\varepsilon_{_{c t}} $$ ",
