{
  "question": "Are there other Paddle return fields related to char boxes?",
  "answer": "In the real JSON and installed Paddle/PaddleX source, no additional public char-box field was found. The stable output pair is text_word + text_word_boxes. text_word_region exists inside Paddle OCRResult/pipeline before JSON conversion and may appear in some service/pruned shapes, so the project treats it as an alias. rec_boxes/rec_polys/dt_polys are line/detection geometry, not char boxes. textline_orientation_angles is line orientation metadata, not char geometry.",
  "public_char_or_token_fields": [
    "text_word",
    "text_word_boxes",
    "text_word_region (internal/service alias)",
    "textWord/textWordBoxes/textWordRegion (camelCase compatibility aliases)"
  ],
  "not_char_box_fields": {
    "rec_boxes": "line-level recognized text boxes",
    "rec_polys": "line-level recognized text polygons",
    "dt_polys": "detected text-line polygons before recognition",
    "textline_orientation_angles": "text-line orientation metadata",
    "model_settings": "pipeline switches, not geometry",
    "text_det_params": "detector params, not geometry",
    "return_word_box": "request/result flag that enables word-box output, not geometry itself"
  },
  "source_evidence": [
    "paddlex/inference/pipelines/ocr/pipeline.py initializes text_word/text_word_region when return_word_box is true and later converts text_word_region to text_word_boxes.",
    "paddlex/inference/pipelines/ocr/result.py::_to_json emits text_word_boxes and text_word when available.",
    "paddlex/inference/pipelines/components/common/cal_ocr_word_box.py returns word_box_content_list and word_box_list; Chinese state==cn is split into per-character-ish boxes.",
    "paddlex/inference/models/text_recognition/processors.py returns rec_word_info only inside recognition postprocess; it is consumed by cal_ocr_word_box and is not a public response field.",
    "paddlex/inference/models/text_recognition/predictor.py transformers engine warns it does not support return_word_box."
  ],
